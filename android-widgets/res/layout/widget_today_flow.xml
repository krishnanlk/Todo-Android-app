<!-- widget_today_flow.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_flow_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY FLOW"
        android:textColor="#5E5CE6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_items_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header_label"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Dynamic remote view list items injected from LineUp storage -->
    </LinearLayout>
</RelativeLayout>
